# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER import this in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — used to generate absolute URLs in sitemap.xml. Defaults to a placeholder.
NEXT_PUBLIC_SITE_URL=

# Powers the master ingredient price catalog sync (src/app/api/cron/sync-kamis-prices).
# This is data.go.kr's key for the "한국농수산식품유통공사_공판장 가격 관련 정보" dataset
# (odcloud.kr gateway, NOT kamis.or.kr's own API) — apply at data.go.kr and use the
# "일반 인증키" shown after approval. See src/lib/kamis/client.ts for details/caveats.
KAMIS_ODCLOUD_KEY=

# Powers the beef/pork consumer price sync (src/app/api/cron/sync-ekape-prices).
# data.go.kr's key for "축산물품질평가원_축산물유통정보" (data.go.kr/data/15000577) —
# a different dataset/agency than KAMIS_ODCLOUD_KEY above, but data.go.kr issues one
# key per account across every dataset it's applied for, so this is often the same
# value. See src/lib/ekape/client.ts for details/caveats.
EKAPE_SERVICE_KEY=

# Shared secret the external scheduler (e.g. Vercel Cron) must send as
# `Authorization: Bearer <value>` when hitting /api/cron/sync-kamis-prices or
# /api/cron/sync-ekape-prices. Generate any random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
