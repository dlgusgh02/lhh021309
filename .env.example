# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER import this in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — used to generate absolute URLs in sitemap.xml. Defaults to a placeholder.
NEXT_PUBLIC_SITE_URL=

# KAMIS (농산물유통정보) Open-API — powers the master ingredient price catalog sync
# (src/app/api/cron/sync-kamis-prices). Get these by registering and applying at
# https://www.kamis.or.kr/customer/reference/openapi_write.do
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# Shared secret the external scheduler (e.g. Vercel Cron) must send as
# `Authorization: Bearer <value>` when hitting /api/cron/sync-kamis-prices.
# Generate any random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=
